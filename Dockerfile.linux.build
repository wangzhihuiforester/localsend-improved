# Dockerfile for building LocalSend Linux with maximum compatibility
# Uses Ubuntu 20.04 (glibc 2.31) as base for Kylin OS compatibility
FROM ubuntu:20.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git unzip xz-utils zip ca-certificates \
    clang cmake ninja-build pkg-config patchelf \
    binutils lld lld-10 \
    libgtk-3-dev liblzma-dev libglu1-mesa \
    libayatana-appindicator3-dev libsecret-1-dev libjsoncpp-dev \
    libglib2.0-dev \
    libgraphite2-dev \
    libxdamage-dev libxcomposite-dev libxcursor-dev libxinerama-dev libxrandr-dev \
    libxi-dev libxtst-dev libxfixes-dev libxrender-dev libxext-dev libx11-dev \
    libgbm-dev libdrm-dev libegl-dev libgl-dev libgles-dev \
    libnss3-dev libnspr4-dev \
    libatk1.0-dev libatk-bridge2.0-dev \
    libcups2-dev libdbus-1-dev \
    libpango1.0-dev libcairo2-dev \
    libfribidi-dev libthai-dev \
    libfontconfig1-dev libfreetype6-dev \
    libgdk-pixbuf2.0-dev \
    libwayland-dev libxkbcommon-dev \
    fonts-noto-cjk fonts-wqy-microhei fonts-wqy-zenhei \
    libstdc++6 \
    software-properties-common \
    liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

# Add GCC 12 PPA for libstdc++-12-dev (required by newer Flutter)
# Also create symlinks for LLVM linker (Flutter looks for ld.lld/ld in LLVM dir)
RUN add-apt-repository ppa:ubuntu-toolchain-r/test -y && \
    apt-get update && apt-get install -y --no-install-recommends libstdc++-12-dev && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/ld.lld /usr/lib/llvm-10/bin/ld.lld 2>/dev/null || true && \
    ln -sf /usr/bin/ld /usr/lib/llvm-10/bin/ld 2>/dev/null || true && \
    ls -la /usr/lib/llvm-10/bin/ld* 2>/dev/null || echo "Warning: LLVM bin dir not found"

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.93.1
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Flutter - try specific version tag, fallback to stable
ARG FLUTTER_VERSION=3.41.9
RUN git clone --depth 1 --branch ${FLUTTER_VERSION} https://github.com/flutter/flutter.git /opt/flutter 2>/dev/null || \
    (git clone --depth 1 https://github.com/flutter/flutter.git /opt/flutter && \
     cd /opt/flutter && git fetch --depth 1 origin ${FLUTTER_VERSION} && git checkout ${FLUTTER_VERSION})
ENV PATH="/opt/flutter/bin:${PATH}"

# Enable Linux desktop and precache
RUN flutter config --enable-linux-desktop && \
    flutter precache --linux

# Verify glibc version
RUN echo "=== Build environment info ===" && \
    ldd --version && \
    echo "GCC version:" && \
    gcc --version | head -1 && \
    echo "Clang version:" && \
    clang --version | head -1

# Copy project
WORKDIR /app
COPY . .

# Install dependencies and build
RUN cd app && flutter pub get

RUN cd app && dart run build_runner build --delete-conflicting-outputs || true
RUN cd app && dart run slang || true

# Build Linux release
RUN cd app && flutter build linux --release

# Run the library bundling script
RUN chmod +x /app/scripts/bundle_linux_libs.sh && \
    /app/scripts/bundle_linux_libs.sh /app/build/linux/x64/release/bundle

# Verify the final build
RUN echo "=== Final verification ===" && \
    BUNDLE_DIR="/app/build/linux/x64/release/bundle" && \
    echo "Bundle contents:" && \
    find "$BUNDLE_DIR" -type f | sort && \
    echo "" && \
    echo "glibc requirements:" && \
    readelf -V "$BUNDLE_DIR/localsend_app" 2>/dev/null | grep GLIBC | head -10 && \
    echo "" && \
    echo "Library dependency check:" && \
    ldd "$BUNDLE_DIR/localsend_app" 2>&1 | head -30

# Create the runtime stage - minimal Ubuntu 20.04 with only runtime libs
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install only runtime dependencies (not -dev packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0 \
    libglib2.0-0 \
    libnss3 libnspr4 \
    libsecret-1-0 \
    libayatana-appindicator3-1 \
    libpango-1.0-0 libpangocairo-1.0-0 \
    libcairo2 libcairo-gobject2 \
    libgdk-pixbuf2.0-0 \
    libwayland-client0 libwayland-server0 libwayland-egl1 \
    libxkbcommon0 \
    libxdamage1 libxcomposite1 libxcursor1 libxinerama1 libxrandr2 \
    libxi6 libxtst6 libxfixes3 libxrender1 libxext6 libx11-6 \
    libgbm1 libdrm2 libegl1 libgl1 libgles2 \
    libfontconfig1 libfreetype6 \
    libfribidi0 libthai0 \
    libgraphite2-3 \
    libharfbuzz0b \
    libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdbus-1-3 \
    libepoxy0 \
    libjsoncpp1 \
    libstdc++6 \
    fonts-wqy-microhei fonts-noto-cjk \
    fontconfig \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f

# Copy the bundled application
COPY --from=builder /app/build/linux/x64/release/bundle /app/bundle

WORKDIR /app/bundle

# Default command
CMD ["./localsend_app"]
