FROM ubuntu:20.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl git unzip xz-utils zip \
    clang cmake ninja-build pkg-config \
    libgtk-3-dev libstdc++-12-dev liblzma-dev libglu1-mesa \
    libayatana-appindicator3-dev libsecret-1-dev libjsoncpp-dev \
    libayatana-appindicator3-1 libayatana-ido3-0.4-0 \
    libglib2.0-0 libglib2.0-dev \
    libgraphite2-3 libgraphite2-dev \
    libxdamage1 libxcomposite1 libxcursor1 libxinerama1 libxrandr2 \
    libxi6 libxtst6 libxfixes3 libxrender1 libxext6 libx11-6 \
    libgbm1 libdrm2 libegl1 libgl1 libgles2 \
    libnss3 libnspr4 \
    libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdbus-1-3 \
    libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libcairo-gobject2 \
    libfribidi0 libthai0 \
    libfontconfig1 libfreetype6 \
    libgdk-pixbuf-2.0-0 libgdk-pixbuf2.0-dev \
    libwayland-client0 libwayland-server0 libwayland-egl1 \
    libxkbcommon0 \
    fonts-noto-cjk fonts-wqy-microhei fonts-wqy-zenhei \
    libstdc++6 \
    openjdk-17-jdk \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH="${PATH}:${JAVA_HOME}/bin"

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.93.1
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Flutter
ARG FLUTTER_VERSION=3.41.9
RUN git clone https://github.com/flutter/flutter.git --branch stable --depth 1 /opt/flutter
ENV PATH="/opt/flutter/bin:${PATH}"

# Enable Linux desktop
RUN flutter config --enable-linux-desktop

# Copy project
WORKDIR /app
COPY . .

# Install dependencies and build
RUN cd app && flutter pub get
RUN cd app && dart run build_runner build --delete-conflicting-outputs || true
RUN cd app && dart run slang || true
RUN cd app && flutter build linux --release

# Create the runtime image
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    libgtk-3-0 libglib2.0-0 libnss3 \
    libsecret-1-0 libjsoncpp25 || libjsoncpp24 || libjsoncpp1 \
    libayatana-appindicator3-1 libayatana-ido3-0.4-0 \
    libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libcairo-gobject2 \
    libgdk-pixbuf-2.0-0 \
    libwayland-client0 libwayland-server0 libwayland-egl1 \
    libxkbcommon0 \
    libxdamage1 libxcomposite1 libxcursor1 libxinerama1 libxrandr2 \
    libxi6 libxtst6 libxfixes3 libxrender1 libxext6 libx11-6 \
    libgbm1 libdrm2 libegl1 libgl1 libgles2 \
    libfontconfig1 libfreetype6 \
    libfribidi0 libthai0 \
    libgraphite2-3 \
    libharfbuzz0b \
    libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdbus-1-3 \
    libnspr4 \
    fonts-wqy-microhei fonts-noto-cjk \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/build/linux/x64/release/bundle /app/build/linux/x64/release/bundle
WORKDIR /app/build/linux/x64/release/bundle

CMD ["./localsend_app"]
